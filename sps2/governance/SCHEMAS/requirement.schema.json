{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sps2/requirement/v1",
  "title": "SPS 2.0 Requirement Contract",
  "description": "A requirement is a declared, bounded objective with observable acceptance criteria. Declaration is NOT implementation, NOT verification and NOT approval.",
  "type": "object",
  "required": ["requirement_id", "title", "objective", "scope", "risk", "status",
               "acceptance_criteria", "evidence_refs", "approval"],
  "additionalProperties": false,
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]{2,}$"},
    "title": {"type": "string", "minLength": 3},
    "objective": {"type": "string", "minLength": 10},
    "description": {"type": "string"},
    "scope": {"enum": ["IN_SCOPE", "OUT_OF_SCOPE"]},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "status": {
      "enum": ["DECLARED", "IMPLEMENTED", "VERIFIED", "APPROVED", "REJECTED", "BLOCKED"],
      "description": "Advisory only. The three axes are enforced separately."
    },
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 10},
      "description": "Each criterion must be observable by executing something."
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^EV-[A-Z0-9]+-[0-9]{3,}$"}},
    "implementation": {
      "type": "object", "required": ["state", "refs"], "additionalProperties": false,
      "properties": {
        "state": {"enum": ["NOT_STARTED", "PARTIAL", "COMPLETE"]},
        "refs": {"type": "array", "items": {"type": "string"}},
        "verified": {"type": "boolean", "description": "MUST be false unless evidence is non-empty."},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object", "required": ["state", "method"], "additionalProperties": false,
      "properties": {
        "state": {"enum": ["UNVERIFIED", "VERIFIED", "FAILED", "BLOCKED"]},
        "method": {"enum": ["AUTOMATED", "AGENT", "USER", "EXTERNAL"]},
        "verifier": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "approval": {
      "type": "object", "required": ["state"], "additionalProperties": false,
      "properties": {
        "state": {"enum": ["NOT_REQUIRED", "PENDING_USER_APPROVAL", "APPROVED", "REJECTED"]},
        "decided_by": {"type": "string"},
        "decided_at": {"type": "string"},
        "basis": {"type": "string"}
      }
    }
  }
}