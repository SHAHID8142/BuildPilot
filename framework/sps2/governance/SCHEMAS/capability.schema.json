{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sps2/capability/v1",
  "title": "SPS 2.0 Capability Contract",
  "description": "A candidate unit of work: skill, MCP, library, tool or adapter. Records are NEVER fabricated. An empty registry is valid.",
  "type": "object",
  "required": [
    "capability_id",
    "name",
    "type",
    "domain",
    "source",
    "provenance",
    "version",
    "compatibility",
    "security",
    "staleness",
    "install_scope",
    "verification",
    "approval",
    "lifecycle_state"
  ],
  "additionalProperties": false,
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^CAP-[A-Z0-9]+-[0-9]{3,}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "type": {
      "enum": [
        "SKILL",
        "MCP",
        "LIBRARY",
        "DEV_TOOL",
        "TEST_TOOL",
        "SECURITY_TOOL",
        "SEO_TOOL",
        "CMS_CAPABILITY",
        "DESIGN_CAPABILITY",
        "BACKEND_CAPABILITY",
        "DEPLOY_CAPABILITY",
        "AGENT_ADAPTER",
        "FRAMEWORK_TOOL",
        "RESEARCH_RESOURCE",
        "ICON_LIBRARY"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 2
    },
    "source": {
      "enum": [
        "OFFICIAL_DOCS",
        "OFFICIAL_REPO",
        "PACKAGE_REGISTRY",
        "MAINTAINER_DOCS",
        "INDEPENDENT_TECHNICAL",
        "COMMUNITY",
        "UNKNOWN"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin",
        "captured_at"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "captured_at": {
          "type": "string"
        },
        "fact_class": {
          "enum": [
            "FACT",
            "EVIDENCE",
            "INFERENCE",
            "UNKNOWN"
          ]
        }
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "required": [
        "technology",
        "framework",
        "agent_neutral"
      ],
      "additionalProperties": false,
      "properties": {
        "technology": {
          "enum": [
            "COMPATIBLE",
            "INCOMPATIBLE",
            "UNKNOWN"
          ]
        },
        "framework": {
          "enum": [
            "COMPATIBLE",
            "INCOMPATIBLE",
            "UNKNOWN"
          ]
        },
        "agent_neutral": {
          "type": "boolean"
        },
        "agent_specific_dependency": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "VERIFIED_SAFE",
            "REVIEWED_LOW_RISK",
            "SUSPECTED_RISK",
            "VULNERABLE",
            "UNKNOWN"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "staleness": {
      "type": "object",
      "required": [
        "state",
        "last_checked"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        },
        "last_checked": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_due": {
          "type": [
            "string",
            "null"
          ]
        },
        "maintenance": {
          "enum": [
            "ACTIVE",
            "PASSIVE",
            "ABANDONED",
            "UNKNOWN"
          ]
        }
      }
    },
    "install_scope": {
      "enum": [
        "PROJECT_LOCAL",
        "GLOBAL"
      ]
    },
    "global_installation_authorized_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "MUST NOT name an agent, model or automation. Only the user may approve."
    },
    "project_local_install_method": {
      "type": "string",
      "minLength": 5
    },
    "rollback_method": {
      "type": "string",
      "minLength": 5
    },
    "verification": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "UNVERIFIED",
            "VERIFIED",
            "FAILED"
          ]
        },
        "method": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NOT_REQUIRED",
            "PENDING_USER_APPROVAL",
            "APPROVED",
            "REJECTED"
          ]
        },
        "decided_by": {
          "type": "string",
          "description": "MUST NOT name an agent, model or automation. Only the user may approve."
        },
        "decided_at": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "RESEARCHING",
        "EVALUATED",
        "PROPOSED",
        "PENDING_USER_APPROVAL",
        "APPROVED",
        "INSTALLING",
        "INSTALLED",
        "VERIFIED",
        "ACTIVE",
        "DEPRECATED",
        "REJECTED",
        "FAILED",
        "REMOVED"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluation_id": {
          "type": "string"
        },
        "criteria": {
          "type": "object"
        },
        "selection_reason": {
          "type": "string"
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "research_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}