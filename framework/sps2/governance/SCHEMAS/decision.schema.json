{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sps2/decision/v1",
  "title": "SPS 2.0 Decision Contract",
  "description": "An architectural decision record. User approval is never fabricated or inferred.",
  "type": "object",
  "required": [
    "decision_id",
    "title",
    "decision",
    "reason",
    "evidence",
    "alternatives",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^(?:DEC-[0-9]{4}|D-P[0-9]+(?:-[A-Z0-9]+)*)$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "decision": {
      "type": "string",
      "minLength": 5
    },
    "reason": {
      "type": "string",
      "minLength": 10
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "SUPERSEDED",
        "REJECTED"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "PENDING_USER_APPROVAL",
            "APPROVED",
            "REJECTED"
          ]
        },
        "decided_by": {
          "type": "string",
          "description": "MUST NOT name an agent, model or automation. Only the user may approve."
        },
        "decided_at": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    }
  }
}
